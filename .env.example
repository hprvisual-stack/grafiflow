GRAFIFLOW_SUPABASE_URL=
GRAFIFLOW_SUPABASE_ANON_KEY=
GRAFIFLOW_SUPABASE_SECRET_KEY=
# Compatibilidade com chave legada; prefira GRAFIFLOW_SUPABASE_SECRET_KEY.
GRAFIFLOW_SUPABASE_SERVICE_ROLE_KEY=
GRAFIFLOW_BILLING_ENABLED=false
GRAFIFLOW_APP_URL=https://grafiflow.vercel.app
# Opcional: outras origens HTTPS válidas, separadas por vírgula.
GRAFIFLOW_ALLOWED_ORIGINS=
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Gere um token independente com pelo menos 32 caracteres; não reutilize a chave de API.
ASAAS_WEBHOOK_AUTH_TOKEN=
